{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "essentia-env",
  "compatibility_date": "2026-11-27",
  "main": "worker/index.js",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
