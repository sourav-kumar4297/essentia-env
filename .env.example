# Copy to .env and fill in values. Never commit .env.

# Chatbot. Server-side only — do not prefix with VITE_.
GROQ_API_KEY=

# Lead emails sent by this app. Server-side only — do not prefix with VITE_.
# Office 365 mailbox that both sends and receives, unless CONTACT_TO is set.
CONTACT_EMAIL=info@essentia.in
CONTACT_PASS=
# CONTACT_TO=info@essentia.in
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587

# Optional. Instagram feed only. Leave unset to use the live Vercel API.
# VITE_API_URL=https://essentia-backend-mail.vercel.app
